{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/danielleitedesign/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/(.*)favicon(.*)",
      "destination": "/favicon$2"
    },
    {
      "source": "/(.*)apple-touch-icon(.*)",
      "destination": "/apple-touch-icon$2"
    }
  ]
}
